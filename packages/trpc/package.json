{
  "name": "@flash-ship/ecom-trpc",
  "version": "1.0.0",
  "main": "./server/index.ts",
  "types": "./server/index.ts",
  "exports": {
    ".": {
      "types": "./server/index.ts",
      "default": "./server/index.ts"
    },
    "./customer": {
      "types": "./server/index.ts",
      "default": "./server/index.ts"
    },
    "./admin": {
      "types": "./server/index.ts",
      "default": "./server/index.ts"
    },
    "./web": {
      "types": "./server/index.ts",
      "default": "./server/index.ts"
    },
    "./server": {
      "types": "./server/index.ts",
      "default": "./server/index.ts"
    },
    "./server/*": {
      "types": "./server/*.ts",
      "default": "./server/*.ts"
    },
    "./*": {
      "types": "./*.ts",
      "default": "./*.ts"
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly --outDir dist",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@trpc/server": "^11.1.0",
    "exceljs": "^4.4.0",
    "superjson": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "date-fns": "^4.4.0",
    "next": "16.2.6",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
