{
  "extends": "@flash-ship/ecom-tsconfig/library.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "..",
    "declaration": true,
    "emitDeclarationOnly": true,
    "paths": {
      "@flash-ship/ecom-trpc/*": [
        "./server/*"
      ],
      "@ecom/trpc/*": [
        "./server/*"
      ],
      "@ecom/features/*": [
        "../features/*"
      ],
      "@ecom/prisma": [
        "../prisma/src"
      ],
      "@ecom/prisma/*": [
        "../prisma/*"
      ],
      "@flash-ship/ecom-lib/*": [
        "../lib/src/*"
      ],
      "@flash-ship/ecom-lib": [
        "../lib/src"
      ],
      "@flash-ship/ecom-types": [
        "../types/src"
      ],
      "@flash-ship/ecom-i18n": [
        "../i18n/src"
      ]
    },
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": [
    "server/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
