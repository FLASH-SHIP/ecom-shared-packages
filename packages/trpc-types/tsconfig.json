{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "paths": {
      "@ecom/features/*": ["./stubs/index.d.ts"],
      "@ecom/prisma": ["./stubs/index.d.ts"],
      "@ecom/prisma/*": ["./stubs/index.d.ts"]
    }
  },
  "include": ["src/**/*", "stubs/**/*"]
}
